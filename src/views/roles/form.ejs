<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
</head>
<body>
<%- include('../partials/nav') %>
<h1><%= title %></h1>

<% if (error) { %>
    <p style="color: red;"><%= error %></p>
<% } %>

<form method="post" action="<%= action %>">
    <p><label>Nume: <input name="nume" maxlength="20" value="<%= role.nume || '' %>" required></label></p>
    <p>
        <button type="submit">Salveaza</button>
        <a href="/roles">Anuleaza</a>
    </p>
</form>
</body>
</html>