<nav>
    <a href="/catalog">Catalog</a>
    <% if (currentUser && ['angajat', 'admin'].includes(currentUser.rol)) { %>
        | <a href="/cars">Masini</a>
        | <a href="/rentals">Rezervari</a>
        | <a href="/payments">Plati</a>
    <% } %>
    <% if (currentUser && currentUser.rol === 'admin') { %>
        | <a href="/categories">Categorii</a>
        | <a href="/extras">Optiuni</a>
        | <a href="/users">Utilizatori</a>
        | <a href="/roles">Roluri</a>
    <% } %>
    <span style="float: right;">
        <% if (currentUser) { %>
            <%= currentUser.nume %> (<%= currentUser.rol %>)
            <form method="post" action="/logout" style="display: inline;">
        <button type="submit">Iesire</button>
      </form>
        <% } else { %>
            <a href="/login">Autentificare</a> | <a href="/register">Cont nou</a>
        <% } %>
    </span>
</nav>
<hr>