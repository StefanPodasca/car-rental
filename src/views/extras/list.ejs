<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <title>Optiuni - Inchirieri auto</title>
</head>
<body>
<%- include('../partials/nav') %>
<h1>Optiuni suplimentare</h1>
<p><a href="/extras/new">+ Adauga optiune</a></p>

<% if (error) { %>
    <p style="color: red;"><%= error %></p>
<% } %>

<table border="1" cellpadding="6">
    <tr>
        <th>ID</th><th>Nume</th><th>Pret/zi</th><th>Nr. rezervari</th><th>Actiuni</th>
    </tr>
    <% extras.forEach(function (extra) { %>
        <tr>
            <td><%= extra.id %></td>
            <td><%= extra.nume %></td>
            <td><%= extra.pret_pe_zi %> lei</td>
            <td><%= extra.nr_rezervari %></td>
            <td>
                <a href="/extras/<%= extra.id %>/edit">Editeaza</a>
                <form method="post" action="/extras/<%= extra.id %>/delete" style="display:inline;"
                      onsubmit="return confirm('Stergi optiunea <%= extra.nume %>?');">
                    <button type="submit">Sterge</button>
                </form>
            </td>
        </tr>
    <% }); %>
</table>
</body>
</html>