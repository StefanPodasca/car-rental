<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <title>Rezervare - Inchirieri auto</title>
</head>
<body>
<%- include('../partials/nav') %>
<h1>Rezerva o masina</h1>

<% if (error) { %>
    <p style="color: red;"><%= error %></p>
<% } %>

<% if (!car) { %>
    <p>Masina aleasa nu exista. <a href="/catalog">Inapoi la catalog</a></p>
<% } else { %>
    <p><strong><%= car.marca %> <%= car.model %></strong> (<%= car.an %>) - <%= car.pret_pe_zi %> lei/zi</p>

    <form method="post" action="/my-rentals">
        <input type="hidden" name="car_id" value="<%= car.id %>">
        <p><label>De la: <input type="date" name="data_start" min="<%= today %>" value="<%= rental.data_start || '' %>" required></label></p>
        <p><label>Pana la: <input type="date" name="data_end" min="<%= today %>" value="<%= rental.data_end || '' %>" required></label></p>

        <p><strong>Optiuni suplimentare:</strong></p>
        <% extras.forEach(function (e) { %>
            <p>
                <label>
                    <input type="checkbox" name="extras" value="<%= e.id %>" <%= selected[e.id] ? 'checked' : '' %>>
                    <%= e.nume %> (<%= e.pret_pe_zi %> lei/zi)
                </label>
                Cantitate: <input type="number" name="qty_<%= e.id %>" min="1" value="<%= selected[e.id] || 1 %>" style="width: 60px;">
            </p>
        <% }); %>

        <p><small>Pretul total se calculeaza automat: zile x (pret masina + optiuni). Rezervarea va fi confirmata de un angajat.</small></p>
        <p>
            <button type="submit">Rezerva</button>
            <a href="/catalog">Anuleaza</a>
        </p>
    </form>
<% } %>
</body>
</html>