<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
</head>
<body>
<%- include('../partials/nav') %>
<h1><%= title %></h1>

<% if (error) { %>
    <p style="color: red;"><%= error %></p>
<% } %>

<form method="post" action="<%= action %>">
    <p><label>Nume: <input name="nume" maxlength="50" value="<%= category.nume || '' %>" required></label></p>
    <p><label>Descriere:<br>
            <textarea name="descriere" rows="3" cols="40"><%= category.descriere || '' %></textarea></label></p>
    <p>
        <button type="submit">Salveaza</button>
        <a href="/categories">Anuleaza</a>
    </p>
</form>
</body>
</html>